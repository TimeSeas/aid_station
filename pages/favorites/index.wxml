<!-- pages/favorites/index.wxml -->
<view class="container">
<view class="search-box" style="height: 83rpx; display: block; box-sizing: border-box">
  <input
      placeholder="搜索收藏的文章"
      bindinput="onInput"
      class="search-input"
    />
    <!-- 放大镜图标 -->
    <view class="search-icon" bindtap="onSearchIconTap">
      <text>搜索</text>
    </view>
  </view>
<scroll-view scroll-y class="fav-list">
  <block wx:for="{{filteredFavorites}}" wx:key="id">
    <!-- 收藏项容器 -->
    <view class="article-card" bindtap="goToDetail" data-id="{{item.id}}">
      <!-- 左边：封面图片 -->
      <image class="cover" src="{{item.coverImage}}"/>

      <!-- 中间：标题和摘要 -->
      <view class="info">
        <text class="title">{{item.title}}</text>
        <text class="summary">{{item.summary}}</text>
      </view>

      <!-- 右边：星星按钮 -->
      <view
        class="star-btn {{item.isFavorite ? 'active' : ''}}"
        catchtap="toggleFavorite"
        data-id="{{item.id}}"
      >
        ★
      </view>
    </view>
  </block>
</scroll-view>
</view>
