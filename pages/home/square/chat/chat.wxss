/* 容器样式 */
.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f5f5f5;
}

/* 顶部导航栏样式 */
.chat-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  border-bottom: 2rpx solid #ccc;
}

.header-left {
  display: flex;
  align-items: center;
}

.back-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-right: 10rpx;
}

.header-title {
  font-size: 30rpx;
  font-weight: bold;
}

.unread-count {
  font-size: 24rpx;
  color: red;
  margin-left: 10rpx;
}

.header-right {
  display: flex;
  align-items: center;
}

.tag {
  margin-right: 20rpx;
  padding: 6rpx 12rpx;
  border: 2rpx solid #ccc;
  border-radius: 10rpx;
  font-size: 24rpx;
}

.more-icon {
  font-size: 36rpx;
}

/* 消息列表样式 */
.chat-messages {
  flex: 1;
  overflow-y: auto;
  padding: 20rpx;
  background-color: #fff;
}

.message {
  display: flex;
  flex-direction: column;
  margin-bottom: 20rpx;
}

.message-bubble {
  display: flex;
  align-items: flex-start;
  max-width: 80%;
  margin-bottom: 20rpx;
}

.bubble-content {
  padding: 15rpx 20rpx;
  border-radius: 10rpx;
  font-size: 28rpx;
  word-wrap: break-word;
}

.user-bubble {
  align-self: flex-end;
  flex-direction: row-reverse;
}

.user-bubble .bubble-content {
  background-color: #00c853; /* 绿色气泡 */
  color: #fff;
}

.admin-bubble {
  align-self: flex-start;
}

.admin-bubble .bubble-content {
  background-color: #fff; /* 白色气泡 */
  color: #333;
  border: 2rpx solid #ccc;
}

/* 底部输入框样式 */
.chat-input {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background-color: #fff;
}

input {
  flex: 1;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 20rpx;
  border: 2rpx solid #ccc;
  border-radius: 30rpx;
  font-size: 28rpx;
  margin-right: 20rpx;
}

.send-btn {
  width: 120rpx;
  height: 60rpx;
  line-height: 60rpx;
  font-size: 28rpx;
  border-radius: 30rpx;
  color: #fff;
  background-color: #ff9800;
}