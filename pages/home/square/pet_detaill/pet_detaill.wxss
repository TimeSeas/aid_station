.container {
  padding: 20rpx;
}

.pet-swiper {
  height: 500rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.swiper-image {
  width: 100%;
  height: 100%;
}

.info-card {
  background: #fff;
  padding: 30rpx;
  margin: 30rpx 0;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.meta text {
  margin-right: 20rpx;
  padding: 8rpx 16rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.status {
  margin-top: 30rpx;
  color: #fff;
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
  display: inline-block;
  background: #07c160;
}

.status.adopted {
  background: #e64340;
}

.detail-card {
  background: #fff;
  padding: 30rpx;
  border-radius: 12rpx;
}

.section {
  margin-bottom: 30rpx;
}

.label {
  color: #666;
  font-size: 30rpx;
}

.value {
  color: #333;
  font-size: 32rpx;
}

/* 固定底部按钮区域 */
.fixed-bottom {
  position: fixed; /* 固定定位 */
  bottom: 0; /* 距离底部 0 */
  left: 0; /* 距离左侧 0 */
  right: 0; /* 距离右侧 0 */
  display: flex; /* 水平排列按钮 */
  justify-content: space-around; /* 按钮之间均匀分布 */
  align-items: center; /* 垂直居中对齐 */
  background: #fff; /* 白色背景 */
  padding: 20rpx 0; /* 上下内边距 */
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.1); /* 添加阴影效果 */
}

.chat-btn, .adopt-btn {
  width: 45%; /* 按钮宽度占一半 */
  height: 80rpx; /* 按钮高度 */
  line-height: 80rpx; /* 文字垂直居中 */
  font-size: 40rpx; /* 字体大小 */
  border-radius: 40rpx; /* 圆角 */
  color: #fff; /* 字体颜色 */
  text-align: center; /* 文字居中 */
}

.chat-btn {
  background: #f8990b; /* 绿色背景 */
}

.adopt-btn {
  background: #07ebcc; /* 红色背景 */
}