.container {
  padding: 20rpx;
}

.pet-swiper {
  height: 500rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.swiper-image {
  width: 100%;
  height: 100%;
}

.info-card {
  background: #fff;
  padding: 30rpx;
  margin: 30rpx 0;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.meta text {
  margin-right: 20rpx;
  padding: 8rpx 16rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.status {
  margin-top: 30rpx;
  color: #fff;
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
  display: inline-block;
  background: #07c160;
}

.status.adopted {
  background: #e64340;
}

.detail-card {
  background: #fff;
  padding: 30rpx;
  border-radius: 12rpx;
}

.section {
  margin-bottom: 30rpx;
}

.label {
  color: #666;
  font-size: 30rpx;
}

.value {
  color: #333;
  font-size: 32rpx;
}