
<view class="container">

  <swiper class="pet-swiper" indicator-dots="{{true}}">
    <block wx:for="{{pet.images}}" wx:key="index">
      <swiper-item>
        <image src="{{item}}" mode="aspectFill" class="swiper-image"/>
      </swiper-item>
    </block>
  </swiper>


  <view class="info-card">
    <view class="title">{{pet.name}}</view>
    <view class="meta">
      <text class="species">{{pet.species}}</text>
      <text class="gender">{{pet.gender === 1 ? '公' : (pet.gender === 2 ? '母' : '未知')}}</text>
      <text class="age">{{pet.age}}月</text>
    </view>


    <view class="status {{pet.is_adopted ? 'adopted' : ''}}">
      {{pet.is_adopted ? '已领养' : '待领养'}}
    </view>
  </view>


  <view class="detail-card">
    <view class="section">
      <text class="label">健康状态：</text>
      <text class="value">{{pet.health_status || '暂无记录'}}</text>
    </view>
    <view class="section">
      <text class="label">宠物描述：</text>
      <text class="value">{{pet.description}}</text>
    </view>
  </view>


  <block wx:if="{{showButtons}}">

  <view class="fixed-bottom">
      <button class="chat-btn" bindtap="navigateToChat">聊一聊</button>
      <button class="adopt-btn" disabled="{{pet.is_adopted}}" bindtap="navigateToAdoptForm">我要领养</button>
    </view>
</block>


</view>
