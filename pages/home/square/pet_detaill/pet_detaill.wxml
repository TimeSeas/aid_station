<!-- pages\home\square\pet_detaill\pet_detaill.wxml -->
<view class="container">
  <!-- 图片轮播 -->
  <swiper class="pet-swiper" indicator-dots="{{true}}">
    <block wx:for="{{pet.images}}" wx:key="index">
      <swiper-item>
        <image src="{{item}}" mode="aspectFill" class="swiper-image"/>
      </swiper-item>
    </block>
  </swiper>

  <!-- 基本信息 -->
  <view class="info-card">
    <view class="title">{{pet.name}}</view>
    <view class="meta">
      <text class="species">{{pet.species}}</text>
      <text class="gender">{{pet.gender | genderFilter}}</text>
      <text class="age">{{pet.age}}月</text>
    </view>
    
    <!-- 领养状态 -->
    <view class="status {{pet.is_adopted ? 'adopted' : ''}}">
      {{pet.is_adopted ? '已领养' : '待领养'}}
    </view>
  </view>

  <!-- 详细信息 -->
  <view class="detail-card">
    <view class="section">
      <text class="label">健康状态：</text>
      <text class="value">{{pet.health_status || '暂无记录'}}</text>
    </view>
    <view class="section">
      <text class="label">宠物描述：</text>
      <text class="value">{{pet.description}}</text>
    </view>
  </view>
  <!-- 固定底部按钮区域 -->
  <!-- <block wx:if="{{ pet.created_by === getApp().globalData.userId }}">
    <view>这是您创建的宠物信息</view>
  </block> -->
  <block wx:if="{{showButtons}}">
    <!-- <view class="fixed-bottom" Estyle="position: fixed; left: -33rpx; top: 1281rpx" style="line-height: 80rpx; padding-bottom: 10rpx; height: 156rpx; display: flex; box-sizing: border-box; left: 0rpx; top: 1304rpx">
    <button class="chat-btn" bindtap="navigateToChat" style="position: relative; left: -2rpx; top: -24rpx; width: 331rpx; display: block; box-sizing: border-box; line-height: 50rpx">聊一聊</button>
    <button class="adopt-btn" bindtap="navigateToAdoptForm" style="position: relative; left: -2rpx; top: -24rpx; width: 331rpx; display: block; box-sizing: border-box; line-height: 50rpx">我要领养</button>
  </view> -->
  <view class="fixed-bottom">
      <button class="chat-btn" bindtap="navigateToChat">聊一聊</button>
      <button class="adopt-btn" bindtap="navigateToAdoptForm">我要领养</button>
    </view>
</block>


</view>