.home{padding:40rpx 30rpx 160rpx;background:#f6f5ef;min-height:100vh;box-sizing:border-box;color:#233e32}.hero{padding:16rpx 8rpx 32rpx}.eyebrow{font-size:21rpx;letter-spacing:3rpx;color:#637c6d}.headline{font-size:49rpx;line-height:1.5;font-weight:650;margin:22rpx 0 14rpx}.headline text{display:block}.intro{font-size:26rpx;color:#7c8178}.banner{height:300rpx;border-radius:24rpx;overflow:hidden}.banner image{width:100%;height:100%}.rescue-entry{margin:26rpx 0 34rpx;padding:26rpx;background:#e4ecdf;border-radius:18rpx;display:flex;align-items:center;justify-content:space-between}.entry-title{font-size:28rpx;font-weight:600;margin-bottom:8rpx}.rescue-entry text{font-size:24rpx;color:#5d7565}.nav-tabs{display:flex;gap:46rpx;border-bottom:1rpx solid #dedfd6;margin-bottom:28rpx}.tab{padding:12rpx 4rpx 20rpx;font-size:30rpx;color:#8b8d83}.tab.active{color:#285b44;font-weight:600;border-bottom:4rpx solid #285b44}.pet-list{display:flex;flex-direction:row;flex-wrap:wrap;justify-content:space-between;gap:22rpx}.pet-card{width:48%;background:#fff;border-radius:20rpx;overflow:hidden}.pet-card image{width:100%;height:260rpx}.pet-info{padding:22rpx 18rpx}.pet-name{font-size:32rpx;font-weight:600;display:flex;align-items:center;justify-content:space-between}.badge{font-size:18rpx;padding:5rpx 10rpx;background:#ecf1e7;color:#527346;border-radius:8rpx;font-weight:400}.pet-meta{font-size:23rpx;color:#8a8d82;margin-top:12rpx;display:block}.notice,.more,.empty{padding:36rpx 20rpx;text-align:center;color:#7b8176;font-size:26rpx;width:100%}.post-card{padding:28rpx;background:#fff;border-radius:20rpx;margin-bottom:24rpx}.post-author{display:flex;align-items:center;gap:16rpx;font-size:27rpx;font-weight:600}.post-author image{width:64rpx;height:64rpx;border-radius:50%}.post-content{font-size:29rpx;line-height:1.8;margin:22rpx 0;white-space:pre-wrap;overflow-wrap:break-word}.post-cover{width:100%;height:280rpx;border-radius:12rpx}.knowledge-card{display:flex;align-items:center;justify-conten