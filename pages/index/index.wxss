/* index.wxss */
.post-item {
  padding: 20rpx;
  border-bottom: 1rpx solid #eee;
}

.title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.content {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.meta {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #999;
}

.swiper {
  height: 300rpx;
}

.swiper-image {
  width: 100%;
  height: 100%;
}

.nav-tabs {
  background: #fff;
  padding: 20rpx 0;
}

.scroll-x {
  white-space: nowrap;
}

.tabs-container {
  display: flex;
  justify-content: space-around;
}

.tab-item {
  display: inline-block;
  padding: 20rpx 40rpx;
  font-size: 32rpx;
  color: #666;
  transition: all 0.3s;
}

.tab-item.active {
  color: #ff9000;
  font-weight: bold;
  border-bottom: 4rpx solid #ff9000;
}

.content-swiper {
  height: calc(100vh - 300rpx - 80rpx);
}

.content-scroll {
  height: 100%;
  padding: 20rpx;
}

.content-item {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}
