<view class="home">
  <view class="hero"><text class="eyebrow">AID STATION · 暖爪救助站</text><view class="headline">让每一次相遇，<text>都有温暖的归处。</text></view><view class="intro">认识一位新伙伴，记录一份善意。</view></view>
  <swiper class="banner" autoplay interval="5000" indicator-dots indicator-active-color="#30745a">
    <swiper-item wx:for="{{swiperList}}" wx:key="index"><image src="{{item.image}}" mode="aspectFill"/></swiper-item>
  </swiper>
  <view class="rescue-entry" bindtap="onPublishHelp"><view><view class="entry-title">身边的生命，需要你的帮助</view><text>查看救助需求与最新进展</text></view><text>→</text></view>
  <view class="nav-tabs"><view wx:for="{{tabs}}" wx:key="index" class="tab {{currentIndex === index ? 'active' : ''}}" bindtap="switchTab" data-index="{{index}}">{{item}}</view></view>
  <view wx:if="{{error}}" class="notice" bindtap="refresh">{{error}} · 点击重试</view>
  <view wx:if="{{currentIndex === 0}}" class="pet-list">
    <navigator wx:for="{{petList}}" wx:key="pet_id" url="/pages/home/square/pet_detaill/pet_detaill?id={{item.pet_id}}" class="pet-card">
      <image src="{{item.cover || '/images/animals/dog1.jpg'}}" mode="aspectFill"/>
      <view class="pet-info"><view class="pet-name">{{item.name}}<text class="badge">待领养</text></view><text class="pet-meta">{{item.species}} · {{item.age}}个月</text></view>
    </navigator>
    <view wx:if="{{!petList.length && !isLoading && !error}}" class="empty">暂时没有待领养的伙伴</view>
    <view wx:if="{{hasMore && !error}}" class="more" bindtap="loadData">{{isLoading ? '加载中…' : '加载更多'}}</view>
  </view>
  <view wx:if="{{currentIndex === 1}}" class="post-list">
    <view wx:for="{{posts}}" wx:key="post_id" class="post-card" bindtap="toPostDetail" data-id="{{item.post_id}}"><view class="post-author"><image src="{{item.avatar}}"/><text>{{item.nickname}}</text></view><view class="post-content">{{item.content}}</view><image wx:if="{{item.images.length}}" class="post-cover" src="{{item.images[0]}}" mode="aspectFill"/><text class="pet-meta">{{item.post_time}} · 查看动态与评论 →</text></view>
    <view wx:if="{{!posts.length && !error}}" class="empty">暂无动态，点击下方加号分享一份善意。</view>
  </view>
  <view wx:if="{{currentIndex === 2}}" class="knowledge-list"><view class="knowledge-card" bindtap="onkepu"><text>01</text><view>认识流浪动物<view class="pet-meta">从了解开始，让关爱更有方向</view></view><text>→</text></view><view class="knowledge-card" bindtap="onjiu"><text>02</text><view>救助指南<view class="pet-meta">遇见需要帮助的动物时</view></view><text>→</text></view><view class="knowledge-card" bindtap="onling"><text>03</text><view>领养知识<view class="pet-meta">为长期陪伴做好准备</view></view><text>→</text></view></view>
  <view class="footer">以领养代替购买，以陪伴回应信任。</view>
</view>
