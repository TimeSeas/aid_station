<view class="container">
  <form bindsubmit="submitForm">
    <view class="form-item">
      <text class="label">动物名称</text>
      <input 
        name="name" 
        placeholder="请输入动物名称" 
        class="input"
        data-field="name"
        bindinput="bindInput"
      />
    </view>
    
    <view class="form-item">
      <text class="label">发现位置</text>
      <input 
        name="location" 
        placeholder="请输入详细地址（示例：XX路XX号附近）" 
        class="input"
        data-field="location"
        bindinput="bindInput"
      />
    </view>
    
    <view class="form-item">
      <text class="label">上传照片（最多3张）</text>
      <view class="uploader">
        <block wx:for="{{tempImages}}" wx:key="index">
          <image 
            src="{{item}}" 
            class="preview" 
            mode="aspectFill"
            bindtap="previewImage" 
            data-url="{{item}}"
          />
        </block>
        <view 
          wx:if="{{tempImages.length < 3}}" 
          class="upload-btn" 
          bindtap="chooseImage"
        >
          <text>+</text>
        </view>
      </view>
    </view>
    
    <button 
      formType="submit" 
      class="submit-btn" 
      hover-class="none"
      disabled="{{isSubmitting}}"
    >
      {{isSubmitting ? '提交中...' : '提交求助信息'}}
    </button>
  </form>
</view>