/* pages/rescue/publish/publish.wxss */
.container {
  padding: 30rpx;
  background: #f7f7f7;
  min-height: 100vh;
}

.form-item {
  margin-bottom: 40rpx;
  background: #fff;
  padding: 28rpx;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}

.label {
  display: block;
  font-size: 30rpx;
  color: #333;
  margin-bottom: 20rpx;
  font-weight: 500;
}

.input {
  height: 80rpx;
  padding: 0 20rpx;
  background: #f8f8f8;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.uploader {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.upload-btn {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 60rpx;
  color: #999;
  background: #fafafa;
}

.preview {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
}

.submit-btn {
  margin-top: 60rpx;
  background: #07c160;
  color: #fff;
  border-radius: 40rpx;
  font-size: 37rpx;
  height: 80rpx;
  line-height: 52rpx;
}

.submit-btn[disabled] {
  background-color: #e0e0e0 !important;
  color: #999 !important;
}

.preview {
  margin: 5rpx;
}