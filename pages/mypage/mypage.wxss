.profile{padding:48rpx 30rpx 180rpx;min-height:100vh;background:#f6f5ef;box-sizing:border-box;color:#233e32}.eyebrow{font-size:21rpx;letter-spacing:3rpx;color:#637c6d}.profile-card{display:flex;align-items:center;gap:28rpx;padding:45rpx 0}.profile-card image{width:120rpx;height:120rpx;border-radius:50%;background:#e4ecdf;flex-shrink:0}.nickname{font-size:36rpx;font-weight:600;margin-bottom:14rpx}.profile-card text,.login-card text{font-size:24rpx;color:#7b8176}.edit{font-size:24rpx;color:#337054;margin-top:16rpx}.login-card{background:#fff;padding:34rpx;border-radius:22rpx;margin:34rpx 0}.login-card button{margin:30rpx 0 24rpx;background:#2f6b50;color:white;border-radius:14rpx;font-size:28rpx}.login-card navigator{font-size:25rpx;color:#337054}.hint{font-size:22rpx;color:#959687;margin-top:24rpx}.stat{display:flex;justify-content:space-between;padding:26rpx;background:#e4ecdf;border-radius:16rpx;font-size:28rpx}.section-title{font-size:29rpx;font-weight:600;margin:40rpx 0 22rpx}.pet-list{display:flex;gap:20rpx;flex-wrap:wrap}.pet-card{width:calc(50% - 10rpx);background:white;overflow:hidden;border-radius:18rpx}.pet-card image{width:100%;height:220rpx}.pet-card>view{padding:20rpx;font-size:28rpx;display:flex;justify-content:space-between}.pet-card text{color:#729579;font-size:22rpx}.empty{font-size:25rpx;color:#8a8d82;padding:30rpx 0}.menu{background:white;border-radius:20rpx;margin-top:36rpx;padding:0 28rpx}.menu>view{padding:32rpx 0;border-bottom:1rpx solid #eff0ea;font-size:28rpx;display:flex;justify-content:space-between}.menu text{color:#8d9b89}
