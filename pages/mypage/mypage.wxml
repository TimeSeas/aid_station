<!--pages/user/index/index.wxml-->
<scroll-view scroll-y class="page-content" >
  <view class="a">
    <view class="view" />
  </view>
     <!-- 用户信息区域  open-type="chooseAvatar"
        bindchooseavatar="onChooseAvatar"-->

    <view class="bar1">

      <block wx:if="{{!hasUserInfo}}">
      <button class="hidden-button"
      wx:if="{{canIUseGetUserProfile}}" bindtap="handleLogin" style="position: relative; left: 2rpx; top: 0rpx">微信一键登录</button>
      <!-- <image class="avatar" src="{{userInfo.avatarUrl}}" mode="cover"></image> -->
    </block>
<!-- <button class="hidden-button"bind:tap="navigateTologin" wx:if="{{isLogin==false}}" style="position: absolute; left: 306rpx; top: 109rpx; width: 262rpx; display: block; box-sizing: border-box">
        手机号登录
</button> -->
<!-- 头像区域 -->

<block wx:else>
      <view class="user">
        <image class="avatar" src="{{userInfo.avatarUrl}}" style="position: relative; left: -43rpx; top: 96rpx"></image>
        <view class="name" style="width: 258rpx; height: 49rpx; display: block; box-sizing: border-box; position: relative; left: 124rpx; top: -34rpx">{{userInfo.nickName}}</view>
        <view class="sub" style="width: 235rpx; height: 49rpx; display: block; box-sizing: border-box; position: relative; left: 147rpx; top: -49rpx">关爱生命，人人有责</view>
      </view>
</block>

      <view class="card"><iconfont type="saoyisao" size="25px" color="white" /></view>
    </view>
    <view class="bar2">
      <view class="item">
        <view class="num">{{stats.followers}}</view>
        粉丝
      </view>
      <view class="item">
        <view class="num">{{stats.posts}}</view>
        动态
      </view>
      <view class="item">
        <view class="num">{{stats.following}}</view>
        关注
      </view>
      <!-- 在mypage.wxml的列表区域添加 -->
    </view>
