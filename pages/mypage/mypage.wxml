<view class="profile">
  <text class="eyebrow">MY STATION · 我的暖爪</text>
  <view class="profile-card" wx:if="{{hasUserInfo}}"><image src="{{userInfo.avatarUrl}}" mode="aspectFill" bindtap="bindViewTap"/><view><view class="nickname" bindtap="bindViewTap">{{userInfo.nickname}}</view><text>关爱生命，从每一次陪伴开始。</text><view class="edit" bindtap="bindViewTap">编辑个人资料 →</view></view></view>
  <view wx:else class="login-card"><view class="nickname">欢迎，新的守护者</view><text>登录后可发布、交流与申请领养。</text><button bindtap="handleLogin" loading="{{loggingIn}}" disabled="{{loggingIn}}">{{demoMode ? '体验演示账号' : '微信登录'}}</button><navigator url="/pages/myhome/login-form/login-form">手机号与密码登录 / 注册 →</navigator><view wx:if="{{demoMode}}" class="hint">当前为作品集演示环境，请使用虚构资料。</view></view>
  <navigator wx:if="{{hasUserInfo}}" class="stat" url="/pages/myhome/userPost/userPost?id={{userId}}"><text>我的动态</text><text>{{stats.posts}} 篇 →</text></navigator>
  <view class="section-title">我发布的待领养伙伴</view>
  <view class="pet-list"><navigator wx:for="{{myPets}}" wx:key="pet_id" class="pet-card" url="/pages/home/square/pet_detaill/pet_detaill?id={{item.pet_id}}"><image src="{{item.cover || '/images/animals/dog1.jpg'}}" mode="aspectFill"/><view>{{item.name}}<text>{{item.is_adopted ? '已领养' : '待领养'}}</text></view></navigator><view wx:if="{{!myPets.length}}" class="empty">暂无宠物信息，点击下方加号登记。</view></view>
  <view class="menu"><view bindtap="goToApplications">领养申请与审核<text>→</text></view><view bindtap="goToMessages">我的消息<text>→</text></view><view bindtap="goToFavorites">我的文章收藏<text>→</text></view><view wx:if="{{hasUserInfo}}" bindtap="logout">退出登录<text>→</text></view></view>
</view>
