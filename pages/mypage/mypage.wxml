 <!-- 修改 "我的爱宠" 区域 -->
<view class="label">我的爱宠</view>
<view class="bar4">
  <swiper 
    class="pet-swiper" 
    indicator-dots="{{true}}"
    indicator-color="rgba(0,0,0,.3)"
    indicator-active-color="#ffd700"
    bindchange="swiperChange"
    circular
  >
    <block wx:for="{{myPets}}" wx:key="pet_id">
      <swiper-item>
        <navigator url="/pages/home/square/pet_detaill/pet_detaill?id={{item.pet_id}}">
          <image src="{{item.cover}}" mode="aspectFill" class="pet-cover"/>
          <view class="pet-info">
            <text class="name">{{item.name}}</text>
            <text class="status {{item.is_adopted ? 'adopted' : ''}}">
              {{item.is_adopted ? '已领养' : '待领养'}}
            </text>
          </view>
        </navigator>
      </swiper-item>
    </block>
  </swiper>
  
  <!-- 空状态提示 -->
  <view wx:if="{{myPets.length === 0}}" class="empty-pets">
    <!-- <image src="/images/empty-pet.png" class="empty-icon"/> -->
    <text class="empty-icon">暂无宠物信息，快去添加吧~</text>
  </view>
</view>
    <view class="list">
      <view class="item"bindtap="goToFavorites"><iconfont type="favorite" class="ico" size="20px" />我的收藏</view>
      <view class="item"><iconfont type="comment" class="ico" size="20px" />我的评论</view>
      <!-- <view class="item"><iconfont type="share" class="ico" size="20px" />我的分享</view> -->
    </view>
</scroll-view>
<view class="page-tabbar page-ipx-safe-area"></view>