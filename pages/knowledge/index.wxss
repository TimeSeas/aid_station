/* pages/knowledge/index.wxss */

.container {
  padding: 20rpx;
}

.search-box {
  background: #f5f5f5;
  border-radius: 40rpx;
  padding: 0 30rpx;
  margin-bottom: 20rpx;
}

.search-input {
  height: 80rpx;
  font-size: 28rpx;
}

.category-tabs {
  white-space: nowrap;
  margin: 20rpx 0;
}

.tab-item {
  display: inline-block;
  padding: 20rpx 40rpx;
  margin-right: 20rpx;
  background: #f0f0f0;
  border-radius: 40rpx;
}

.tab-item.active {
  background: #07c160;
  color: white;
}

.article-card {
  margin-bottom: 30rpx;
  background: white;
  border-radius: 16rpx;
  overflow: hidden;
}

.cover {
  width: 100%;
  height: 300rpx;
}

.info {
  padding: 20rpx;
}

.title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.summary {
  color: #666;
  line-height: 1.6;
}