/* 微博风格主色调 */
:root {
  --weibo-orange: #ff8200;
  --weibo-bg: #f6f6f6;
}

.publish-container {
  height: 100vh;
  background: var(--weibo-bg);
  display: flex;
  flex-direction: column;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 90rpx;
  padding: 0 30rpx;
  background: #fff;
  border-bottom: 1rpx solid #e5e5e5;
}

.title {
  font-weight: 600;
  color: #333;
}

.cancel-btn, .submit-btn {
  color: var(--weibo-orange);
  font-size: 32rpx;
}

.submit-btn {
  background: var(--weibo-orange);
  color: white;
  padding: 8rpx 24rpx;
  border-radius: 40rpx;
}

.editor-container {
  flex: 1;
  padding: 30rpx;
}

.content-input {
  width: 100%;
  min-height: 300rpx;
  font-size: 34rpx;
  line-height: 1.6;
}

.placeholder-style {
  color: #999;
}

.image-preview {
  display: flex;
  flex-wrap: wrap;
  margin-top: 30rpx;
}

.preview-item {
  width: 220rpx;
  height: 220rpx;
  margin: 0 20rpx 20rpx 0;
  position: relative;
}

.preview-image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.delete-btn {
  position: absolute;
  right: -10rpx;
  top: -10rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0,0,0,0.5);
  border-radius: 50%;
  color: white;
  text-align: center;
  line-height: 40rpx;
  font-size: 36rpx;
}

.toolbar {
  height: 100rpx;
  padding: 0 30rpx;
  background: #fff;
  display: flex;
  align-items: center;
  border-top: 1rpx solid #e5e5e5;
}

.tool-item {
  display: flex;
  align-items: center;
  margin-right: 40rpx;
  color: #666;
}

.icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 10rpx;
}

.word-count {
  margin-left: auto;
  color: #999;
}