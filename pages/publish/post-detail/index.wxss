.container {
  padding: 20rpx;
}
.post-detail {
  margin-bottom: 40rpx;
}
.title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}
.content {
  font-size: 30rpx;
  margin-bottom: 20rpx;
}
.meta {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 20rpx;
}
.actions button {
  margin-right: 20rpx;
}
.comment-item {
  border-bottom: 1rpx solid #eee;
  padding: 20rpx 0;
}
.comment-meta {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 10rpx;
}
.comment-actions button {
  margin-right: 20rpx;
}
.comment-input textarea {
  width: 100%;
  height: 150rpx;
  padding: 20rpx;
  border: 1rpx solid #ccc;
  margin-bottom: 20rpx;
}