/* pages/admin/pet-upload/index.wxss */
.container {
  padding: 20rpx;
}

.form-item {
  margin: 30rpx 0;
  padding: 20rpx;
  background: #fff;
  border-radius: 12rpx;
}

.label {
  font-weight: 500;
  margin-bottom: 20rpx;
  display: block;
}

.radio-group {
  display: flex;
  gap: 40rpx;
}

.upload-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.upload-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 8rpx;
}

.upload-btn {
  width: 300rpx;
  height: 100rpx;
  border: 2rpx dashed rgb(236, 1, 1);
  display: flex;
  align-items: center;
  justify-content: center;
}