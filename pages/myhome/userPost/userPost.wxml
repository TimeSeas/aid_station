<view class="container">
  <!-- 加载状态 -->
  <view wx:if="{{isLoading}}" class="loading">加载中...</view>

  <!-- 动态列表 -->
  <block  wx:for="{{posts}}" wx:key="post_id">
  <view class="post-item" bindtap="toPostDetail" data-id="{{item.post_id}}">
    <!-- 用户信息 -->
    <view class="user-info">
      <image src="{{item.avatar}}" class="avatar"></image>
      <text class="nickname">{{item.nickname}}</text>
    </view>

    <!-- 动态内容 -->
    <view class="post-content">{{item.content}}</view>

    <!-- 图片展示 -->
    <view wx:if="{{item.images.length}}" class="image-container">
      <block wx:for="{{item.images}}" wx:key="index">
        <image src="{{item}}" mode="aspectFill" class="post-image"></image>
      </block>
    </view>

    <!-- 底部信息 -->
    <view class="post-footer">
      <text class="post-time">{{item.post_time}}</text>
      <view class="like">
        <image src="/images/icon/like.png" class="like-icon"></image>
        <text>{{item.like_count}}</text>
      </view>
    </view>
  </view>
</block>
