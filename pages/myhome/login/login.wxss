/* 容器样式 */
.profile-container {
  padding: 40rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

/* 头像区域 */
.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.avatar-wrapper {
  padding: 0;
  background: transparent;
  border-radius: 50%;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 4rpx solid #fff;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}

.avatar-tip {
  font-size: 24rpx;
  color: #666;
  margin-top: 20rpx;
}

/* 输入区域 */
.input-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 40rpx;
}

.nickname-input {
  height: 80rpx;
  font-size: 32rpx;
}

/* 身份展示 */
.role-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
}

.role-label {
  color: #999;
  font-size: 28rpx;
}

.role-value {
  color: #333;
  font-size: 32rpx;
  margin-left: 20rpx;
}

/* 提交按钮 */
.submit-btn {
  width: 80%;
  margin: 60rpx auto 0;
  background: #07c160;
  color: #fff;
  border-radius: 48rpx;
}