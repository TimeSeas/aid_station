/* register.wxss */
.password-field {
  position: relative;
}
.password-field image {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 40rpx;
  height: 40rpx;
}
.btn-register {
  background: #49c926;
  color: white;
  border-radius: 50rpx;
}
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
}

.input-group {
  width: 100%;
  margin-bottom: 80rpx;  /* 输入组底部留白 */
}

.input-item {
  width: 100%;
  height: 100rpx;
  margin: 50rpx 0;       /* 关键间距设置[4](@ref) */
  padding: 0 30rpx;
  border: 2rpx solid #e5e5e5;
  border-radius: 60rpx;
  font-size: 32rpx;
  transition: all 0.3s;  /* 添加过渡动画 */
}

/* 增强交互效果 */
.input-item:focus {
  border-color: #49c926;
  box-shadow: 0 4rpx 12rpx rgba(73,201,38,0.15);
}

.btn-register {
  width: 80%;
  height: 100rpx;
  margin-top: 40rpx;     /* 按钮与输入组间距 */
  font-size: 36rpx;
  letter-spacing: 4rpx;  /* 文字间距优化[4](@ref) */
}