<!-- mobile_register.wxml 修改后 -->
<view class="container">
  <view class="input-group">
    <input class="input-item" placeholder="手机号" type="number" bindinput="onPhoneInput"/>
    <input class="input-item" placeholder="用户名" bindinput="onUsernameInput"/>
    <input class="input-item" placeholder="密码" password bindinput="onPasswordInput"/>
    <view class="role-selector">
    <radio-group bindchange="onRoleChange">
      <label class="radio-item">
        <radio value="0" checked/> 普通用户
      </label>
      <label class="radio-item">
        <radio value="1"/> 管理员
      </label>
    </radio-group>
  </view>
  </view>
  <button class="btn-register" bindtap="handleRegister">立即注册</button>
</view>