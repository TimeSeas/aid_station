/* 新增通用输入框样式 */
.input-group {
  width: 80%;
  margin: 40rpx 0;
}

.input-box {
  width: 100%;
  height: 100rpx;
  margin: 40rpx 0;  /* 关键间距设置 */
  padding: 0 30rpx;
  border: 1rpx solid #ddd;
  border-radius: 50rpx;
  font-size: 32rpx;
}

.submit-btn {
  width: 70%;
  height: 90rpx;
  margin-top: 60rpx;
  border-radius: 45rpx;
  background: #07c160;
  color: white;
}